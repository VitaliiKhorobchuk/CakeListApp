*.apks
*.jks
*.keystore
keystore.properties
signing.properties

# Local environment and service credentials
.env
.env.*
!.env.example
google-services.json

# Keep the Gradle wrapper in version control, including its JAR.
!gradle/wrapper/gradle-wrapper.jar
